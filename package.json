{
  "name": "striideai-local-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StriideAi local analysis lab (TwelveLabs Pegasus + Gemini + FalkorDB + bounded Code Mode)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "doctor": "node --disable-warning=ExperimentalWarning --import tsx src/cli/doctor.ts",
    "provider:smoke": "node --disable-warning=ExperimentalWarning --import tsx src/cli/provider-smoke.ts",
    "ontology:import": "node --disable-warning=ExperimentalWarning --import tsx src/cli/ontology-import.ts",
    "analyse": "node --disable-warning=ExperimentalWarning --import tsx src/cli/analyse.ts",
    "ui": "node --disable-warning=ExperimentalWarning --import tsx src/cli/ui.ts",
    "batch": "node --disable-warning=ExperimentalWarning --import tsx src/cli/batch.ts",
    "cleanup": "node --disable-warning=ExperimentalWarning --import tsx src/cli/cleanup.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:reference": "node --test examples/telemetry.test.mjs",
    "build": "tsc -p tsconfig.json --noEmit && node --check src/orchestration/codemode/bootstrap.template.js && node --check programs/reviewed/default-v1.js"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "ajv": "8.20.0",
    "falkordb": "7.0.0",
    "twelvelabs-js": "1.3.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "deno": "2.9.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
