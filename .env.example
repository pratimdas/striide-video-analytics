# Copy to .env. Never paste real values into chat or commit them.
TWELVE_LABS_API_KEY=
GEMINI_API_KEY=
# Enter exact supported model IDs for your Gemini project; doctor validates format,
# and the explicit live smoke test verifies actual access.
GEMINI_PLANNER_MODEL=
GEMINI_INSPECTOR_MODEL=
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
FALKORDB_IMAGE=falkordb/falkordb:latest
FALKORDB_BROWSER_PORT=3000
# Optional override for executable paths; otherwise use PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DENO_BIN=deno

# Set a different project name in each coding-agent comparison folder.
COMPOSE_PROJECT_NAME=striideai-local-lab
